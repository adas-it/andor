{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "users_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://user-service"
          }
        }
      },
      "identity_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://user-identity"
          }
        }
      },
      "assets_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://assets-service"
          }
        }
      },
      "accounts_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://accounts-api"
          }
        }
      },
      "communications_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://communications-api"
          }
        }
      },
      "onboarding_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://onboarding-api"
          }
        }
      },
      "configurations_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://configurations-service"
          }
        }
      }
    }
