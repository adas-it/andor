{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:3000",
      "https://localhost:3001",
      "http://localhost:3001"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users_cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity_cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "assets-route": {
        "ClusterId": "assets_cluster",
        "Match": {
          "Path": "/assets/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assets" }
        ]
      },
      "accounts-route": {
