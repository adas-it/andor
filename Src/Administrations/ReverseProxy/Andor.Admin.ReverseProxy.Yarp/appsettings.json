{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "http://localhost:3000",
      "https://localhost:3001",
      "http://localhost:3001"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users_cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity_cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "assets-route": {
        "ClusterId": "assets_cluster",
        "Match": {
          "Path": "/assets/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assets" }
        ]
      },
      "accounts-route": {
        "ClusterId": "accounts_cluster",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "communications-route": {
        "ClusterId": "communications_cluster",
        "Match": {
          "Path": "/communications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/communications" }
        ]
      },
      "onboarding-route": {
        "ClusterId": "onboarding_cluster",
        "Match": {
          "Path": "/onboarding/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/onboarding" }
        ]
      },
      "configurations-route": {
        "ClusterId": "configurations_cluster",
        "Match": {
          "Path": "/configurations/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/configurations" }
        ]
      }
    },
    "Clusters": {
      "users_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://user-identity"
          }
        }
      },
      "identity_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://user-identity"
          }
        }
      },
      "assets_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://assets-service"
          }
        }
      },
      "accounts_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://accounts-api"
          }
        }
      },
      "communications_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://communications-api"
          }
        }
      },
      "onboarding_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://onboarding-api"
          }
        }
      },
      "configurations_cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://configurations-service"
          }
        }
      }
    }
  }
}