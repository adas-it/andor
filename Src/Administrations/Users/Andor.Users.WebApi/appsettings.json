{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=master;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "OpenIddictClients": {
    "WebApp": {
      "ClientId": "web-app",
      "DisplayName": "Web Application",
      "RedirectUris": [
        "https://localhost:52733/oauth2-redirect.html",
        "https://localhost:7001/oauth2-redirect.html",
        "https://localhost:7301/oauth2-redirect.html"
      ]
    },
    "Kenobi": {
      "ClientId": "kenobi",
      "DisplayName": "Kenobi SPA",
      "RedirectUris": [
        "https://localhost:3001/callback",
        "http://localhost:3001/callback",
        "http://localhost:3000/callback",
        "https://localhost:3000/callback"
      ]
    },
    "OnboardingService": {
      // Service-to-service client (client_credentials grant) — Onboarding uses it to call
      // POST /v1/users on Andor.Users.Service. Override ClientSecret outside this file
      // (User Secrets / Key Vault / env var) for anything beyond local dev.
      "ClientId": "onboarding-service",
      "ClientSecret": "REPLACE_WITH_YOUR_SECRET"
    }
  },
  "IdentityProvisioningQueue": {
    // Listen-only SAS scoped to just this one queue, not the app's broader credential.
    "FullyQualifiedNamespace": "REPLACE_WITH_YOUR_NAMESPACE.servicebus.windows.net",
    "QueueName": "request-identity-user",
    "ConnectionString": "REPLACE_WITH_YOUR_CONNECTION_STRING"
  },
  "CorsAllowedOrigins": [
    "https://localhost:52733",
    "https://localhost:7001",
    "https://localhost:5001",
    "http://localhost:3001",
    "https://localhost:3001",
    "http://localhost:3000",
    "https://localhost:7301"

  ]
}
