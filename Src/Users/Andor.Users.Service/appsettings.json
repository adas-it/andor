{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceBus": {
    "FullyQualifiedNamespace": "REPLACE_WITH_YOUR_NAMESPACE.servicebus.windows.net",
    "TopicName": "andor-users-events",
    "ConnectionString": "REPLACE_WITH_YOUR_CONNECTION_STRING",
    "Queues": {
      // Each gets a Send-only SAS scoped to just its one queue, issued by whoever owns that
      // queue — not this app's broader ServiceBus credential above.
      "IdentityProvisioning": {
        "FullyQualifiedNamespace": "REPLACE_WITH_YOUR_NAMESPACE.servicebus.windows.net",
        "QueueName": "request-identity-user",
        "ConnectionString": "REPLACE_WITH_YOUR_CONNECTION_STRING"
      },
      "AccountProvisioning": {
        "FullyQualifiedNamespace": "REPLACE_WITH_YOUR_NAMESPACE.servicebus.windows.net",
        "QueueName": "request-account-creation",
        "ConnectionString": "REPLACE_WITH_YOUR_CONNECTION_STRING"
      }
    }
  },
  "Tenants": [
    {
      "ConnectionString": "Server=localhost;Database=master;Trusted_Connection=True;TrustServerCertificate=True;",
      "DatabaseType": "SQLServer",
      "Name": "TenantA"
    }
  ],
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:3000",
      "https://localhost:5001",
      "http://localhost:3001",
      "https://localhost:3001"
    ]
  },
  "IdentityProvider": {
    "Authority": "https://localhost:7116",
    "Audience": "family_budget",
    "SwaggerClientId": "web-app",
    "Scopes": []
  },
  "OpenTelemetryConfig": {
    "ServiceName": "Andor.Users.Service",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317"
  }
}
